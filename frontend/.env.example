# ==============================================================================
# CampusEats Frontend — Environment Variables Template
# ==============================================================================
# WARNING: All variables prefixed with `NEXT_PUBLIC_` are exposed to the client
# browser and baked into the static build bundles. NEVER place private API keys,
# database credentials, or signing secrets into this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# API Backend Connection
# ------------------------------------------------------------------------------
# In local development: "http://localhost:4000" (or leave empty to use Next.js rewrite proxy)
# In production (behind reverse proxy / same domain): "" or "/api/v1"
# In production (separate API domain): "https://api.campuseats.university.edu"
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# Application Branding & Display Name
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CampusEats

# ------------------------------------------------------------------------------
# Client Runtime Environment Identifier
# ------------------------------------------------------------------------------
# Options: development | staging | production
NEXT_PUBLIC_APP_ENV=production
